<apex:page controller="ClientPlanPDFController"
    renderAs="pdf"
    showHeader="false"
    sidebar="false"
    standardStylesheets="false"
    applyBodyTag="false"
    applyHtmlTag="false"
    docType="html-5.0">

<html>
<head>
    <meta charset="UTF-8"/>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #1d1d1d;
            background: #fff;
        }

        /* ── Cover header ── */
        .cover {
            background: #032D60;
            color: #fff;
            padding: 36px 40px 28px;
            margin-bottom: 24px;
        }
        .cover-label {
            font-size: 10px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            opacity: 0.7;
            margin-bottom: 6px;
        }
        .cover-title {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .cover-sub {
            font-size: 12px;
            opacity: 0.8;
        }
        .cover-meta {
            margin-top: 16px;
            font-size: 10px;
            opacity: 0.65;
        }

        /* ── Section cards ── */
        .section {
            margin: 0 32px 20px;
            border: 1px solid #dddbda;
            border-radius: 6px;
            overflow: hidden;
            page-break-inside: avoid;
        }
        .section-header {
            background: #f3f2f2;
            border-bottom: 1px solid #dddbda;
            padding: 8px 16px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #444;
        }
        .section-body {
            padding: 14px 16px;
            background: #fff;
        }

        /* ── Two-column detail grid ── */
        .detail-grid {
            display: table;
            width: 100%;
        }
        .detail-row {
            display: table-row;
        }
        .detail-label {
            display: table-cell;
            width: 38%;
            font-weight: bold;
            color: #706E6B;
            padding: 4px 8px 4px 0;
            vertical-align: top;
        }
        .detail-value {
            display: table-cell;
            color: #1d1d1d;
            padding: 4px 0;
            vertical-align: top;
        }

        /* ── Contact card ── */
        .contact-name {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 2px;
        }
        .contact-title {
            color: #706E6B;
            margin-bottom: 8px;
        }

        /* ── Tables ── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10.5px;
        }
        thead tr {
            background: #f3f2f2;
        }
        th {
            text-align: left;
            padding: 6px 8px;
            font-weight: bold;
            color: #444;
            border-bottom: 1px solid #dddbda;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            padding: 6px 8px;
            border-bottom: 1px solid #f3f2f2;
            vertical-align: top;
        }
        tr:last-child td { border-bottom: none; }

        /* ── Badges ── */
        .badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 9px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-growth {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
        }
        .badge-hq {
            background: #032D60;
            color: #fff;
        }
        .badge-office {
            background: #e8f4fd;
            color: #0176d3;
            border: 1px solid #b3d9f7;
        }

        /* ── Summary KPI strip ── */
        .kpi-strip {
            display: table;
            width: 100%;
            border: 1px solid #dddbda;
            border-radius: 6px;
            overflow: hidden;
            margin: 0 32px 20px;
            width: calc(100% - 64px);
        }
        .kpi-cell {
            display: table-cell;
            text-align: center;
            padding: 14px 10px;
            border-right: 1px solid #dddbda;
            width: 25%;
        }
        .kpi-cell:last-child { border-right: none; }
        .kpi-value {
            font-size: 20px;
            font-weight: bold;
            color: #032D60;
        }
        .kpi-label {
            font-size: 9px;
            color: #706E6B;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 3px;
        }

        /* ── Global presence grid ── */
        .presence-grid {
            display: table;
            width: 100%;
        }
        .presence-row { display: table-row; }
        .presence-cell {
            display: table-cell;
            width: 33%;
            padding: 5px 6px;
            vertical-align: top;
        }
        .presence-card {
            border: 1px solid #dddbda;
            border-radius: 4px;
            padding: 6px 10px;
            background: #fafaf9;
        }
        .presence-card-name {
            font-weight: bold;
            font-size: 10px;
            margin-bottom: 2px;
        }
        .presence-card-loc {
            font-size: 9.5px;
            color: #706E6B;
        }

        /* ── Footer ── */
        .footer {
            margin: 24px 32px 0;
            padding-top: 8px;
            border-top: 1px solid #dddbda;
            font-size: 9px;
            color: #aaa;
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- Cover -->
    <div class="cover">
        <div class="cover-label">Client Plan</div>
        <div class="cover-title">{!account.Name}</div>
        <div class="cover-sub">{!account.Industry} &nbsp;&bull;&nbsp; {!account.Type}</div>
        <div class="cover-meta">Account Owner: {!account.Owner.Name}</div>
    </div>

    <!-- KPI Strip -->
    <div class="kpi-strip">
        <div class="kpi-cell">
            <div class="kpi-value">{!opportunities.size}</div>
            <div class="kpi-label">Open Opportunities</div>
        </div>
        <div class="kpi-cell">
            <div class="kpi-value">{!formattedPipeline}</div>
            <div class="kpi-label">Pipeline Value</div>
        </div>
        <div class="kpi-cell">
            <div class="kpi-value">{!entitlements.size}</div>
            <div class="kpi-label">Active Entitlements</div>
        </div>
        <div class="kpi-cell">
            <div class="kpi-value">{!subsidiaryRows.size}</div>
            <div class="kpi-label">Global Locations</div>
        </div>
    </div>

    <!-- Account Overview -->
    <div class="section">
        <div class="section-header">Account Overview</div>
        <div class="section-body">
            <div class="detail-grid">
                <div class="detail-row">
                    <div class="detail-label">Billing Address</div>
                    <div class="detail-value">{!billingAddress}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Phone</div>
                    <div class="detail-value">{!account.Phone}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Website</div>
                    <div class="detail-value">{!account.Website}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Employees</div>
                    <div class="detail-value">{!account.NumberOfEmployees}</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Annual Revenue</div>
                    <div class="detail-value">{!formattedRevenue}</div>
                </div>
                <apex:outputPanel rendered="{!NOT(ISNULL(account.Description))}">
                <div class="detail-row">
                    <div class="detail-label">Description</div>
                    <div class="detail-value">{!account.Description}</div>
                </div>
                </apex:outputPanel>
            </div>
        </div>
    </div>

    <!-- Primary Contact -->
    <apex:outputPanel rendered="{!NOT(ISNULL(primaryContact))}">
    <div class="section">
        <div class="section-header">Primary Contact</div>
        <div class="section-body">
            <div class="contact-name">{!primaryContact.FirstName} {!primaryContact.LastName}</div>
            <div class="contact-title">{!primaryContact.Title}</div>
            <div class="detail-grid">
                <apex:outputPanel rendered="{!NOT(ISNULL(primaryContact.Email))}">
                <div class="detail-row">
                    <div class="detail-label">Email</div>
                    <div class="detail-value">{!primaryContact.Email}</div>
                </div>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISNULL(primaryContact.Phone))}">
                <div class="detail-row">
                    <div class="detail-label">Phone</div>
                    <div class="detail-value">{!primaryContact.Phone}</div>
                </div>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISNULL(primaryContact.MobilePhone))}">
                <div class="detail-row">
                    <div class="detail-label">Mobile</div>
                    <div class="detail-value">{!primaryContact.MobilePhone}</div>
                </div>
                </apex:outputPanel>
            </div>
        </div>
    </div>
    </apex:outputPanel>

    <!-- Opportunity Pipeline -->
    <div class="section">
        <div class="section-header">Opportunity Pipeline</div>
        <div class="section-body">
            <apex:outputPanel rendered="{!opportunities.size > 0}">
            <table>
                <thead>
                    <tr>
                        <th>Opportunity</th>
                        <th>Stage</th>
                        <th>Amount</th>
                        <th>Close Date</th>
                        <th>Probability</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!opportunities}" var="opp">
                    <tr>
                        <td>{!opp.Name}</td>
                        <td>{!opp.StageName}</td>
                        <td><apex:outputText value="${0, number, ###,###,##0}"><apex:param value="{!opp.Amount}"/></apex:outputText></td>
                        <td><apex:outputText value="{0, date, MMM d, yyyy}"><apex:param value="{!opp.CloseDate}"/></apex:outputText></td>
                        <td>{!opp.Probability}%</td>
                    </tr>
                    </apex:repeat>
                </tbody>
            </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!opportunities.size == 0}">
                <p style="color:#706E6B;">No open opportunities.</p>
            </apex:outputPanel>
        </div>
    </div>

    <!-- Service Entitlements -->
    <div class="section">
        <div class="section-header">Service Entitlements</div>
        <div class="section-body">
            <apex:outputPanel rendered="{!entitlements.size > 0}">
            <table>
                <thead>
                    <tr>
                        <th>Entitlement</th>
                        <th>Type</th>
                        <th>Asset</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!entitlements}" var="ent">
                    <tr>
                        <td>{!ent.Name}</td>
                        <td>{!ent.Type}</td>
                        <td>{!ent.Asset.Name}</td>
                        <td><apex:outputText value="{0, date, MMM d, yyyy}"><apex:param value="{!ent.StartDate}"/></apex:outputText></td>
                        <td><apex:outputText value="{0, date, MMM d, yyyy}"><apex:param value="{!ent.EndDate}"/></apex:outputText></td>
                    </tr>
                    </apex:repeat>
                </tbody>
            </table>
            </apex:outputPanel>
            <apex:outputPanel rendered="{!entitlements.size == 0}">
                <p style="color:#706E6B;">No active entitlements.</p>
            </apex:outputPanel>
        </div>
    </div>

    <!-- Global Presence -->
    <apex:outputPanel rendered="{!subsidiaryRows.size > 0}">
    <div class="section">
        <div class="section-header">Global Presence &mdash; {!subsidiaryRows.size} Locations &nbsp;|&nbsp; {!growthMarketCount} Growth Markets</div>
        <div class="section-body">
            <!-- SVG World Map — static continent shapes, dynamic pins via apex:repeat -->
            <div style="margin-bottom:12px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="760" height="380" viewBox="0 0 760 380">
                <!-- Ocean -->
                <rect width="760" height="380" fill="#d6eaf8"/>
                <!-- North America -->
                <polygon points="55,55 75,45 120,42 155,50 175,65 185,85 190,120 180,155 165,185 145,205 115,210 90,195 70,170 58,140 50,100 52,70" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Greenland -->
                <polygon points="165,18 200,12 225,20 220,45 195,52 168,42" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- South America -->
                <polygon points="130,220 160,212 185,220 200,245 205,280 198,320 185,350 165,365 145,355 128,325 118,285 115,255 120,235" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Europe -->
                <polygon points="330,52 355,45 380,48 398,55 405,70 400,90 388,102 368,108 348,105 332,92 325,75 326,60" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Africa -->
                <polygon points="332,112 368,108 395,118 415,138 422,175 420,220 408,265 390,288 368,295 345,280 328,248 320,200 318,158 325,130" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Asia (main) -->
                <polygon points="402,48 450,42 510,40 560,44 598,58 618,80 622,108 608,132 578,148 538,155 495,148 455,135 425,118 408,95 400,72" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Indian Subcontinent bump -->
                <polygon points="468,148 488,155 498,178 488,200 472,195 460,172 458,152" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Southeast Asia / Indochina -->
                <polygon points="538,155 558,158 568,175 560,192 540,188 525,172 528,158" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Australia -->
                <polygon points="558,238 608,228 645,238 660,262 655,295 632,312 598,315 568,298 550,270 548,248" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- UK island -->
                <polygon points="330,58 340,54 344,64 338,72 328,68" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>
                <!-- Japan islands -->
                <polygon points="610,85 618,80 622,90 616,98 608,95" fill="#c8e6c9" stroke="#9e9e9e" stroke-width="0.5"/>

                <!-- Dynamic office pins -->
                <apex:repeat value="{!mapPins}" var="pin">
                    <circle cx="{!pin.cx}" cy="{!pin.cy}" r="{!pin.radius}" fill="{!pin.fill}" stroke="#ffffff" stroke-width="1.5"/>
                    <text x="{!pin.tx}" y="{!pin.ty}" font-size="7" fill="#222222" font-family="Arial">{!pin.label}</text>
                </apex:repeat>

                <!-- Legend -->
                <rect x="8" y="348" width="225" height="26" fill="#ffffff" stroke="#cccccc" stroke-width="0.8"/>
                <circle cx="22" cy="361" r="5" fill="#032D60" stroke="#ffffff" stroke-width="1"/>
                <text x="31" y="365" font-size="8" fill="#333333" font-family="Arial">HQ</text>
                <circle cx="58" cy="361" r="5" fill="#2e7d32" stroke="#ffffff" stroke-width="1"/>
                <text x="67" y="365" font-size="8" fill="#333333" font-family="Arial">Growth Market</text>
                <circle cx="148" cy="361" r="5" fill="#0176d3" stroke="#ffffff" stroke-width="1"/>
                <text x="157" y="365" font-size="8" fill="#333333" font-family="Arial">Regional Office</text>
            </svg>
            </div>
            <!-- Regional presence — 4-column table, Flying Saucer safe styling only -->
            <table width="100%" cellpadding="8" cellspacing="4" style="margin-bottom:14px;">
                <tr>
                    <td width="25%" valign="top" style="background-color:#032D60; padding:10px;">
                        <p style="font-size:9px; color:#ffffff; font-weight:bold; margin-bottom:4px;">HEADQUARTERS</p>
                        <p style="font-size:11px; color:#ffffff; font-weight:bold; margin-bottom:2px;">{!account.BillingCity}</p>
                        <p style="font-size:10px; color:#ccddee;">{!account.BillingCountry}</p>
                        <p style="font-size:9px; color:#aabbcc; margin-top:6px;">{!account.Name}</p>
                    </td>
                    <td width="25%" valign="top" style="background-color:#deeeff; border:1px solid #b3d9f7; padding:10px;">
                        <p style="font-size:9px; color:#0176d3; font-weight:bold; margin-bottom:6px;">EUROPE</p>
                        <apex:repeat value="{!europeRows}" var="row">
                            <p style="font-size:10px; color:#1d1d1d; margin-bottom:3px;">
                                - {!row.acct.BillingCity}
                                <apex:outputText rendered="{!row.isGrowthMarket}" value=" [Growth Market]"/>
                            </p>
                        </apex:repeat>
                        <apex:outputPanel rendered="{!europeRows.size == 0}">
                            <p style="font-size:9px; color:#999;">No offices</p>
                        </apex:outputPanel>
                    </td>
                    <td width="25%" valign="top" style="background-color:#fff8e1; border:1px solid #ffe082; padding:10px;">
                        <p style="font-size:9px; color:#e65100; font-weight:bold; margin-bottom:6px;">MIDDLE EAST</p>
                        <apex:repeat value="{!middleEastRows}" var="row">
                            <p style="font-size:10px; color:#1d1d1d; margin-bottom:3px;">
                                - {!row.acct.BillingCity}
                                <apex:outputText rendered="{!row.isGrowthMarket}" value=" [Growth Market]"/>
                            </p>
                        </apex:repeat>
                        <apex:outputPanel rendered="{!middleEastRows.size == 0}">
                            <p style="font-size:9px; color:#999;">No offices</p>
                        </apex:outputPanel>
                    </td>
                    <td width="25%" valign="top" style="background-color:#e8f5e9; border:1px solid #a5d6a7; padding:10px;">
                        <p style="font-size:9px; color:#2e7d32; font-weight:bold; margin-bottom:6px;">ASIA PACIFIC</p>
                        <apex:repeat value="{!asiaRows}" var="row">
                            <p style="font-size:10px; color:#1d1d1d; margin-bottom:3px;">
                                - {!row.acct.BillingCity}
                                <apex:outputText rendered="{!row.isGrowthMarket}" value=" [Growth Market]"/>
                            </p>
                        </apex:repeat>
                        <apex:outputPanel rendered="{!asiaRows.size == 0}">
                            <p style="font-size:9px; color:#999;">No offices</p>
                        </apex:outputPanel>
                    </td>
                </tr>
            </table>
            <table>
                <thead>
                    <tr>
                        <th>Office</th>
                        <th>City</th>
                        <th>Country</th>
                        <th>Classification</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- HQ row -->
                    <tr>
                        <td><strong>{!account.Name}</strong></td>
                        <td>{!account.BillingCity}</td>
                        <td>{!account.BillingCountry}</td>
                        <td><span class="badge badge-hq">HQ</span></td>
                    </tr>
                    <apex:repeat value="{!subsidiaryRows}" var="row">
                    <tr>
                        <td>{!row.acct.Name}</td>
                        <td>{!row.acct.BillingCity}</td>
                        <td>{!row.acct.BillingCountry}</td>
                        <td>
                            <apex:outputPanel rendered="{!row.isGrowthMarket}">
                                <span class="badge badge-growth">Growth Market</span>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!NOT(row.isGrowthMarket)}">
                                <span class="badge badge-office">Regional Office</span>
                            </apex:outputPanel>
                        </td>
                    </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </div>
    </div>
    </apex:outputPanel>

    <!-- Footer -->
    <div class="footer">
        Confidential &mdash; {!account.Name} Client Plan &mdash; Generated by Salesforce
    </div>

</body>
</html>
</apex:page>
